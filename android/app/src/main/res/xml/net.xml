<?xml version="1.0" encoding="utf-8"?>
<!-- Yalnız sistem sertifikaları: kullanıcı CA'sı ile araya girip abonelik adresi okunamaz.
     HTTP: diňe öz habar serwerimiz üçin (habarlar programmanyň öz açary bilen şifrlenýär). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
